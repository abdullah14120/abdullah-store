<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <include layout="@layout/actionbar_main" />

    <com.aurora.adroid.ui.view.ViewFlipper2
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.aurora.adroid.ui.view.placeholder.ProgressView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:progressText="@string/loading_tasks"
            android:background="#0A0A0A" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/download_status_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#121212"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACTIVE TASKS"
                        android:textColor="#00E676"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />

                    <TextView
                        android:id="@+id/tv_total_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENGINE ACTIVE"
                        android:textColor="#666666"
                        android:textSize="10sp"
                        android:textAllCaps="true" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:scrollbars="vertical"
                    android:paddingTop="8dp"
                    android:clipToPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/download_status_header"
                    tools:listitem="@layout/item_downloads" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.aurora.adroid.ui.view.placeholder.EmptyView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:emptyImage="@drawable/ic_download"
            app:emptyText="@string/no_active_tasks"
            android:alpha="0.8" />

    </com.aurora.adroid.ui.view.ViewFlipper2>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
